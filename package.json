  "version": "0.1.0",
  "type": "module",
  "description": "A website project for Catanduanes, built with React, TypeScript, and Vite.",
  "scripts": {
    "dev": "vite",
    "setup": "tsx scripts/setup.ts",
    "check": "tsx scripts/check.ts",
